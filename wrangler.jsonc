{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "numly",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "routes": [{ "pattern": "numly.jkvapil.cz", "custom_domain": true }]
  // SECRET: `npx wrangler secret put SECRET` in production, .dev.vars locally
}
