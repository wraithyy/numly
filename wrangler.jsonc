{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "numly",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // client-side routes such as /week get index.html; the API must reach the Worker first
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "numly.jkvapil.cz", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "SOCIAL", "class_name": "Social" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Board"] },
    // v2: per-day boards replaced by one SQLite-backed social graph with mutual friendships
    { "tag": "v2", "deleted_classes": ["Board"], "new_sqlite_classes": ["Social"] }
  ]
  // SECRET: `npx wrangler secret put SECRET` in production, .dev.vars locally
}
